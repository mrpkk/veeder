# ── VEEDER (добавить в ~/.env) ─────────────────────────────────────────────
# Токен нового бота от @BotFather. Создать бота с именем veeder.
VEEDER_BOT_TOKEN=1234567890:AAH...

# Цена подписки (Telegram Stars). Для подписки на 30 дней.
VEEDER_STARS=25

# Прокси для связи с api.telegram.org (Tor SOCKS5, как у остальных ботов).
# Если не задан — бот попробует прямое соединение (из этой сети оно висит).
VEEDER_PROXY=socks5h://127.0.0.1:9050